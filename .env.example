# DevPilot AI — Environment Configuration
# Copy this file to .env or ~/.devpilot.env

# n8n Webhook URL (default endpoint)
DEVPILOT_WEBHOOK_URL=http://localhost:5678/webhook/devpilot/commit-message

# Webhook Authorization Token / API Key
# Automatically sent as Authorization: Bearer <token> and standard X-API-KEY
DEVPILOT_WEBHOOK_TOKEN=your_token_or_secret_here

# Alternative aliases also supported:
# X_API_KEY=your_token_here
# DEVPILOT_API_KEY=your_token_here
# N8N_WEBHOOK_TOKEN=your_token_here
